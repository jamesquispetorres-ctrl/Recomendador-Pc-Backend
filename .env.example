# ==============================================================================
# Variables de Entorno de Ejemplo - Backend Django
# ==============================================================================
# Copia este archivo como .env y completa con tus valores reales

# ─── Django ───────────────────────────────────────────
SECRET_KEY=tu-clave-secreta-aqui
DEBUG=True
USE_SQLITE=False

# ─── PostgreSQL (Producción / Render) ────────────────
DATABASE_URL=postgresql://usuario:password@host:5432/laptops_db

# Opcional (credenciales individuales si no usas DATABASE_URL):
DB_NAME=laptops_db
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# ─── Google Gemini API ────────────────────────────────
GEMINI_API_KEY=tu_api_key_de_gemini

# ─── Hosts Permitidos ─────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
